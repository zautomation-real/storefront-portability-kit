<section class="section">
  <div class="section-heading"><p class="eyebrow">Search</p><h1>{{ section.settings.title | escape }}</h1></div>
  <form class="search-form" action="{{ routes.search_url }}" method="get" role="search"><input type="hidden" name="type" value="product"><input type="hidden" name="options[prefix]" value="last"><label><span>Search the store</span><input type="search" name="q" value="{{ search.terms | escape }}"></label><button class="button" type="submit">Search</button></form>
  {% if search.performed %}<div class="product-grid">{% paginate search.results by 24 %}{% assign matched_products = 0 %}{% for item in search.results %}{% if item.object_type == 'product' %}{% if settings.catalog_vendor == blank or item.vendor == settings.catalog_vendor %}{% render 'product-card', product: item %}{% assign matched_products = matched_products | plus: 1 %}{% endif %}{% endif %}{% endfor %}{% if matched_products == 0 %}<p class="empty-state">No products matched that search.</p>{% endif %}<div class="pagination">{{ paginate | default_pagination }}</div>{% endpaginate %}</div>{% endif %}
</section>
{% schema %}
{ "name": "Main search", "settings": [{ "type": "text", "id": "title", "label": "Title", "default": "Find a product" }] }
{% endschema %}

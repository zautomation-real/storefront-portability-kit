<section class="password-page">
  <div class="media password-page__media" aria-hidden="true">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1800 | image_tag: widths: '600,900,1200,1800', loading: 'eager', fetchpriority: 'high' }}
    {% elsif section.settings.fallback_asset != blank %}
      <img src="{{ section.settings.fallback_asset | asset_url }}" alt="" width="1800" height="1800" loading="eager" fetchpriority="high">
    {% endif %}
  </div>
  <div class="password-page__content">
    <p class="password-page__brand">{{ settings.brand_name | default: shop.name | escape }}</p>
    {% if section.settings.eyebrow != blank %}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1>{{ section.settings.title | default: settings.brand_name | default: shop.name | escape }}</h1>
    {% if section.settings.body != blank %}<p class="password-page__intro">{{ section.settings.body | escape }}</p>{% endif %}

    {% form 'storefront_password', class: 'password-form' %}
      {% if form.errors %}<div class="form-message" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
      <label for="Password-{{ section.id }}">{{ section.settings.password_label | escape }}</label>
      <div class="password-form__controls">
        <input id="Password-{{ section.id }}" type="password" name="password" required autocomplete="current-password">
        <button class="button" type="submit">{{ section.settings.button_label | escape }}</button>
      </div>
    {% endform %}
    <p class="password-page__note">{{ section.settings.note | escape }}</p>
  </div>
</section>
{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Private preview" },
    { "type": "text", "id": "title", "label": "Title", "default": "Store preview" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "This storefront is being prepared. Enter the preview password to continue." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback_asset", "label": "Fallback theme asset" },
    { "type": "text", "id": "password_label", "label": "Password label", "default": "Store password" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Enter store" },
    { "type": "text", "id": "note", "label": "Note", "default": "Preview access is provided by the store owner." }
  ]
}
{% endschema %}

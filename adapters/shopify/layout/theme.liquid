<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.theme_color | default: '#17211c' }}">
    {% liquid
      assign brand_name = settings.brand_name | default: shop.name
      assign seo_title = page_title | default: brand_name
      assign seo_description = page_description | default: shop.description | strip_html | strip
      if request.page_type == 'index' or seo_title == shop.name
        assign seo_title = brand_name
      endif
    %}
    <link rel="canonical" href="{{ canonical_url }}">
    {% if settings.favicon != blank %}<link rel="icon" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">{% else %}<link rel="icon" href="{{ '__SOCIAL_IMAGE_ASSET__' | asset_url }}">{% endif %}
    <title>{{ seo_title }}{% unless seo_title contains brand_name %} — {{ brand_name }}{% endunless %}</title>
    {% if seo_description != blank %}<meta name="description" content="{{ seo_description | escape }}">{% endif %}
    {% render 'meta-tags', title: seo_title, description: seo_description, brand_name: brand_name %}
    {% render 'structured-data' %}
    {{ content_for_header }}
    {{ 'brand.css' | asset_url | stylesheet_tag }}
    {{ 'storefront.css' | asset_url | stylesheet_tag }}
    {{ 'shopify.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'storefront.js' | asset_url }}" defer></script>
  </head>
  <body data-brand="__BRAND_ID__" data-layout="__LAYOUT_PRESET__" data-platform="shopify">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% section 'announcement' %}
    {% section 'site-header' %}
    <main id="MainContent" role="main" tabindex="-1">{{ content_for_layout }}</main>
    {% section 'site-footer' %}
    {% section 'cart-drawer' %}
  </body>
</html>

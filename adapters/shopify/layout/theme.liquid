<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.theme_color | default: '#17211c' }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {{ content_for_header }}
    {{ 'brand.css' | asset_url | stylesheet_tag }}
    {{ 'storefront.css' | asset_url | stylesheet_tag }}
    {{ 'shopify.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'storefront.js' | asset_url }}" defer></script>
  </head>
  <body data-brand="__BRAND_ID__">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>
    {% section 'announcement' %}
    {% section 'site-header' %}
    <main id="MainContent" role="main" tabindex="-1">{{ content_for_layout }}</main>
    {% section 'site-footer' %}
    {% section 'cart-drawer' %}
  </body>
</html>

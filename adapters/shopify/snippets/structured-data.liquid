{% assign structured_brand_name = settings.brand_name | default: shop.name %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ structured_brand_name | json }},
  "url": {{ shop.url | json }},{% if settings.brand_logo != blank %}
  "logo": {{ settings.brand_logo | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}{% if settings.social_image != blank %}
  "image": {{ settings.social_image | image_url: width: 1200 | prepend: 'https:' | json }}{% else %}
  "image": {{ '__SOCIAL_IMAGE_ASSET__' | asset_url | prepend: 'https:' | json }}{% endif %}
}
</script>
{% if request.page_type == 'product' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ canonical_url | json }},
    "description": {{ product.description | strip_html | strip | json }},
    "brand": {
      "@type": "Brand",
      "name": {{ structured_brand_name | json }}
    }{% if product.featured_image != blank %},
    "image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}]{% endif %},
    "offers": [
      {% for variant in product.variants %}
        {
          "@type": "Offer",
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }},
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "url": {{ canonical_url | append: '?variant=' | append: variant.id | json }}{% if variant.sku != blank %},
          "sku": {{ variant.sku | json }}{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
  </script>
{% endif %}

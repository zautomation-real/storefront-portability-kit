{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:storefront-kit:catalog",
  "title": "Storefront catalog fixtures",
  "type": "object",
  "required": ["products"],
  "properties": {
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "price", "image", "category", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "name": { "type": "string" },
          "price": { "type": "integer", "minimum": 0 },
          "compareAtPrice": { "type": "integer", "minimum": 0 },
          "image": { "type": "string" },
          "category": { "type": "string" },
          "description": { "type": "string" },
          "details": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["title", "body"],
              "properties": {
                "title": { "type": "string", "minLength": 1 },
                "body": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "badge": { "type": "string" },
          "cardMediaSelector": {
            "type": "object",
            "required": ["option", "choices"],
            "properties": {
              "option": { "type": "string", "minLength": 1 },
              "choices": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "required": ["value", "swatch"],
                  "properties": {
                    "value": { "type": "string", "minLength": 1 },
                    "swatch": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "variantMedia": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["match", "image"],
              "properties": {
                "match": {
                  "type": "object",
                  "minProperties": 1,
                  "propertyNames": { "type": "string", "minLength": 1 },
                  "additionalProperties": { "type": "string", "minLength": 1 }
                },
                "image": { "type": "string", "minLength": 1 },
                "alt": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          },
          "options": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["name", "values"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "values": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "oneOf": [
                      { "type": "string", "minLength": 1 },
                      {
                        "type": "object",
                        "required": ["label"],
                        "properties": {
                          "label": { "type": "string", "minLength": 1 },
                          "priceModifier": { "type": "integer" },
                          "displayLabels": {
                            "type": "object",
                            "minProperties": 1,
                            "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                            "additionalProperties": { "type": "string", "minLength": 1 }
                          },
                          "displayNote": { "type": "string", "minLength": 1 }
                        },
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "presentation": {
                  "type": "object",
                  "required": ["label", "controlLabel", "defaultSystem", "systems"],
                  "properties": {
                    "label": { "type": "string", "minLength": 1 },
                    "controlLabel": { "type": "string", "minLength": 1 },
                    "defaultSystem": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                    "propertyLabel": { "type": "string", "minLength": 1 },
                    "help": { "type": "string", "minLength": 1 },
                    "systems": {
                      "type": "array",
                      "minItems": 2,
                      "items": {
                        "type": "object",
                        "required": ["id", "label"],
                        "properties": {
                          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
                          "label": { "type": "string", "minLength": 1 },
                          "approximate": { "type": "boolean" }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
